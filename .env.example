# Copy to .env and fill in. Used by pipeline/ (GitHub Actions + local runs).
# Never commit .env — it's gitignored.

# Supabase project: emarketscope (separate from other personal projects)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service role key — needed by the pipeline to write; never expose to web/
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — set a hard monthly spend limit in the Anthropic console
# before this key is used for anything beyond local smoke tests (see
# GATE task ahead of Phase 2 in the build plan).
ANTHROPIC_API_KEY=

# Soft guardrail (Phase 7), checked before any billed Claude call in
# weekly/backfill/monthly/quarterly/propose-scope-changes: if this
# month's tracked spend (pipeline_runs.estimated_cost_usd) has already
# reached this many dollars, the run aborts before spending anything more
# and writes a 'failed' pipeline_runs row explaining why. This is a
# cooperative backstop on top of, not instead of, the hard spend limit
# set in the Anthropic console.
# Leave BLANK (unset) to disable the guardrail on purpose -- that's the
# only value that fails open. If you set it to something that fails to
# parse as a positive number (typo, truncated .env), the guardrail fails
# CLOSED and blocks every run until it's fixed -- unlike other optional
# vars in this file, a broken value here is never treated the same as no
# value at all.
MONTHLY_SPEND_LIMIT_USD=

# Resend — used by the backfill's one-time summary email (Phase 3) and by
# weekly/monthly/quarterly email delivery (Phase 6). All share the same
# sender/recipient.
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=

# Personal feedback inbox — forwarded items land here (Phase 5).
# emarketscope@gmail.com per the spec's Setup reference. Gmail + IMAP app
# password (not the Google account password — requires 2-Step
# Verification enabled first, then generate one at
# myaccount.google.com/apppasswords). Graceful fallback: ingestion is
# skipped (not a pipeline failure) when either is unset.
FEEDBACK_INBOX_ADDRESS=
FEEDBACK_INBOX_APP_PASSWORD=
