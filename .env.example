# Copy to .env and fill in. Used by pipeline/ (GitHub Actions + local runs).
# Never commit .env — it's gitignored.

# Supabase project: emarketscope (separate from other personal projects)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service role key — needed by the pipeline to write; never expose to web/
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — set a hard monthly spend limit in the Anthropic console
# before this key is used for anything beyond local smoke tests (see
# GATE task ahead of Phase 2 in the build plan).
ANTHROPIC_API_KEY=

# Resend — used by monthly/quarterly email delivery (Phase 6)
RESEND_API_KEY=

# Personal feedback inbox — forwarded items land here (Phase 5)
FEEDBACK_INBOX_ADDRESS=
FEEDBACK_INBOX_PROVIDER_API_KEY=
