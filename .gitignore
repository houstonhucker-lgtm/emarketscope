# dependencies
node_modules/

# env — broad glob so any backup/save/swap variant an editor or sync tool
# creates next to .env is caught too, not just the exact filenames below.
# .env.example is the one intentional exception — un-ignore it explicitly.
.env
.env.local
.env.*.local
.env.*
.env*.save
*.env.bak
!.env.example

# build output
dist/
build/
.next/
out/

# local fallback copies of rendered digest emails (send.ts writes here
# when Resend isn't configured or a send fails) — real digest content,
# not secrets, but not something to commit
.email-fallback/

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# Supabase CLI local cache (project ref/pooler info, not secrets, but
# machine-specific and regenerated by `supabase link`)
supabase/.temp/

# editor
.vscode/
.idea/
